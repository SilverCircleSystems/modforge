function displayAccent(color, theme) {
  if (theme !== "light" || typeof color !== "string" || color[0] !== "#") return color;
  let c = color.slice(1);
  if (c.length === 3) c = c.split("").map(x => x + x).join("");
  if (c.length !== 6) return color;
  let r = parseInt(c.slice(0, 2), 16),
    g = parseInt(c.slice(2, 4), 16),
    b = parseInt(c.slice(4, 6), 16);
  const lum = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
  if (lum <= 0.62) return color;
  const f = 0.52 / lum;
  const h = n => Math.max(0, Math.min(255, Math.round(n * f))).toString(16).padStart(2, "0");
  return `#${h(r)}${h(g)}${h(b)}`;
}
