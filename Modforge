      if (data) {
        ctx.strokeStyle = "#00ff88";
        ctx.lineWidth = 1.5;
        ctx.shadowColor = "#00ff88";
        ctx.shadowBlur = 4;
        ctx.beginPath();
        const sliceWidth = w / data.length;
