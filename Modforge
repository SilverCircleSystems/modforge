function scaleCustomParam(name, v) {
  const x = typeof v === "number" ? v : parseFloat(v) || 0;
  const n = String(name || "").toLowerCase();
  if (n.includes("cutoff")) return 20 * Math.pow(800, x);
  if (n.includes("freq") || n === "pitch") return 20 * Math.pow(100, x);
  if (n.includes("fine") || n.includes("detune")) return (x - 0.5) * 200;
  if (n.includes("res")) return x * 20;
  if (n.includes("rate")) return 0.1 * Math.pow(200, x);
  return x;
}
class AudioEngine {
  constructor() {
    this.ctx = null;
    this.nodes = {};
    this.masterGain = null;
    this.analyser = null;
    this.isRunning = false;
  }
  init() {
    if (this.ctx) {
      if (this.ctx.state === "suspended") this.ctx.resume();
      return;
    }
    this.ctx = new (window.AudioContext || window.webkitAudioContext)();
    if (this.ctx.state === "suspended") this.ctx.resume();
    this.masterGain = this.ctx.createGain();
    this.masterGain.gain.value = 0.3;
    this.analyser = this.ctx.createAnalyser();
    this.analyser.fftSize = 2048;
    this.masterGain.connect(this.analyser);
    this.analyser.connect(this.ctx.destination);
    this.isRunning = true;
  }
  createModuleNode(moduleId, type, params) {
