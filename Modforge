      const h = canvas.height;
      ctx.fillStyle = "var(--bg)";
      ctx.fillRect(0, 0, w, h);
      ctx.strokeStyle = "var(--surface-2)";
      ctx.lineWidth = 0.5;
      for (let y = 0; y < h; y += h / 4) {
